# ── OAuth con Asana ──────────────────────────────────────────────
# Registra una app OAuth en https://app.asana.com/0/my-apps → "Create new app"
# → pestaña "OAuth", y agrega estas Redirect URLs:
#   - http://localhost:3000/api/auth/callback        (desarrollo local)
#   - https://TU-DOMINIO.vercel.app/api/auth/callback  (producción)
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# Secreto para cifrar la cookie de sesión (AES-256-GCM).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se omite, se usa ASANA_CLIENT_SECRET como respaldo.
SESSION_SECRET=

# Nota: si no configuras OAuth, la app sigue funcionando con el
# Personal Access Token manual (campo en la interfaz).

# ── Control de acceso (usuarios y permisos) ─────────────────────
# Se activa solo cuando hay base de datos. Sin DATABASE_URL el gestor funciona
# como antes (sin inicio de sesión).
#
# Neon Postgres: Vercel → Storage → Neon → conectar al proyecto. La
# integración agrega DATABASE_URL (o POSTGRES_URL) automáticamente.
DATABASE_URL=

# Conexión central de Asana con la que el gestor lee los portafolios (los
# usuarios no necesitan Asana). Token personal del administrador:
# https://app.asana.com/0/my-apps → "Personal access token".
ASANA_ACCESS_TOKEN=

# Primer administrador: se crea al entrar con estos datos mientras no existe
# ningún usuario, y se le pide cambiar la contraseña. Después ya no se usan.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Envío de invitaciones y restablecimientos por SMTP (solo servidor).
SMTP_HOST=
SMTP_PORT=587
# true para TLS directo (465); false para STARTTLS obligatorio (587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# URL pública de confianza para el enlace de acceso (HTTPS).
APP_URL=https://gestor-proyectos-de.vercel.app
