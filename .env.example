# ── OAuth con Asana ──────────────────────────────────────────────
# Registra una app OAuth en https://app.asana.com/0/my-apps → "Create new app"
# → pestaña "OAuth", y agrega estas Redirect URLs:
#   - http://localhost:3000/api/auth/callback        (desarrollo local)
#   - https://TU-DOMINIO.vercel.app/api/auth/callback  (producción)
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# Secreto para cifrar la cookie de sesión (AES-256-GCM).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se omite, se usa ASANA_CLIENT_SECRET como respaldo.
SESSION_SECRET=

# Nota: si no configuras OAuth, la app sigue funcionando con el
# Personal Access Token manual (campo en la interfaz).
